<screen>
	<styles>
		<!-- Tachometer background track (slate grey) -->
		<style
			name="style_rpm_track"
			arc_width="14"
			arc_rounded="false"
			arc_color="0x343844"
		/>
		<!-- Tachometer active bar (pure white) -->
		<style
			name="style_rpm_indicator"
			arc_width="14"
			arc_rounded="false"
			arc_color="0xffffff"
			arc_opa="255"
		/>
		<!-- Instant Consumption Arc (sports red active bar, slate track) -->
		<style
			name="style_consumption_track"
			arc_width="14"
			arc_rounded="false"
			arc_color="0x343844"
		/>
		<style
			name="style_consumption_indicator"
			arc_width="14"
			arc_rounded="false"
			arc_color="0xdd2222"
			arc_opa="255"
		/>
		<!-- Turbo boost track & active indicator (copper rust) -->
		<style
			name="style_turbo_track"
			arc_width="8"
			arc_rounded="false"
			arc_color="0x282c36"
		/>
		<style
			name="style_turbo_indicator"
			arc_width="8"
			arc_rounded="false"
			arc_color="0xb84a22"
			arc_opa="255"
		/>
		<!-- Decorative framing lines (subtle dark slate) -->
		<style
			name="style_thin_frame"
			arc_width="2"
			arc_rounded="false"
			arc_color="0x2e333f"
		/>
		<style
			name="style_top_accent"
			arc_width="2"
			arc_rounded="false"
			arc_color="0x3b4150"
		/>
		<!-- Disable indicator on decorative arcs -->
		<style name="style_no_indicator" arc_width="0" arc_opa="0" />
		<!-- Hide knobs completely -->
		<style
			name="style_knob"
			bg_opa="0"
			border_width="0"
			width="0"
			height="0"
		/>
		<!-- Top 12 o'clock dot -->
		<style
			name="style_dot"
			width="8"
			height="8"
			radius="4"
			bg_color="0xffffff"
			bg_opa="255"
			border_width="0"
		/>
	</styles>
	<view>
		<style name="style_dark" />

		<!-- 1. Instant Consumption Arc on right side (20° to 55°) -->
		<lv_arc
			bg_start_angle="20"
			bg_end_angle="55"
			align="center"
			width="396"
			height="396"
			min_value="0"
			max_value="35"
			bind_value="fuel_consumption"
			clickable="false"
		>
			<style name="style_consumption_track" />
			<style name="style_consumption_indicator" selector="indicator" />
			<style name="style_knob" selector="knob" />
		</lv_arc>

		<!-- 2. Main RPM Tachometer Arc (145° to 35°) -->
		<lv_arc
			bg_start_angle="145"
			bg_end_angle="35"
			align="center"
			width="396"
			height="396"
			min_value="0"
			max_value="5000"
			bind_value="engine_rpm"
			clickable="false"
		>
			<style name="style_rpm_track" />
			<style name="style_rpm_indicator" selector="indicator" />
			<style name="style_knob" selector="knob" />
		</lv_arc>

		<!-- 3. Left Side Framing (double concentric thin lines) -->
		<lv_arc
			bg_start_angle="155"
			bg_end_angle="205"
			start_angle="0"
			end_angle="0"
			align="center"
			width="364"
			height="364"
			clickable="false"
		>
			<style name="style_thin_frame" />
			<style name="style_no_indicator" selector="indicator" />
			<style name="style_knob" selector="knob" />
		</lv_arc>
		<lv_arc
			bg_start_angle="155"
			bg_end_angle="205"
			start_angle="0"
			end_angle="0"
			align="center"
			width="348"
			height="348"
			clickable="false"
		>
			<style name="style_thin_frame" />
			<style name="style_no_indicator" selector="indicator" />
			<style name="style_knob" selector="knob" />
		</lv_arc>

		<!-- 4. Right Side Framing (double concentric thin lines) -->
		<lv_arc
			bg_start_angle="335"
			bg_end_angle="25"
			start_angle="0"
			end_angle="0"
			align="center"
			width="364"
			height="364"
			clickable="false"
		>
			<style name="style_thin_frame" />
			<style name="style_no_indicator" selector="indicator" />
			<style name="style_knob" selector="knob" />
		</lv_arc>
		<lv_arc
			bg_start_angle="335"
			bg_end_angle="25"
			start_angle="0"
			end_angle="0"
			align="center"
			width="348"
			height="348"
			clickable="false"
		>
			<style name="style_thin_frame" />
			<style name="style_no_indicator" selector="indicator" />
			<style name="style_knob" selector="knob" />
		</lv_arc>

		<!-- 5. Top Accent Arc under notch -->
		<lv_arc
			bg_start_angle="230"
			bg_end_angle="310"
			start_angle="0"
			end_angle="0"
			align="center"
			width="340"
			height="340"
			clickable="false"
		>
			<style name="style_top_accent" />
			<style name="style_no_indicator" selector="indicator" />
			<style name="style_knob" selector="knob" />
		</lv_arc>

		<!-- 6. Top notch white dot (12 o'clock) -->
		<lv_obj align="top_mid" y="24">
			<style name="style_dot" />
		</lv_obj>

		<!-- 7. Bottom Turbo Boost Arc (65° to 115°) -->
		<lv_arc
			bg_start_angle="65"
			bg_end_angle="115"
			align="center"
			width="400"
			height="400"
			min_value="0"
			max_value="250"
			bind_value="turbo_boost"
			clickable="false"
		>
			<style name="style_turbo_track" />
			<style name="style_turbo_indicator" selector="indicator" />
			<style name="style_knob" selector="knob" />
		</lv_arc>

		<!-- 8. Top Section: Speed & km/h -->
		<lv_label
			bind_text="speed_str"
			align="top_mid"
			y="52"
			style_text_font="roboto_bold_40"
			style_text_color="0xffffff"
		/>
		<lv_label
			text="km/h"
			align="top_mid"
			y="92"
			style_text_font="roboto_regular_24"
			style_text_color="0x7a8394"
		/>

		<!-- 9. Center Hero: Coolant Temp -->
		<lv_label
			bind_text="coolant_temp_str"
			align="center"
			y="-18"
			style_text_font="roboto_bold_150"
			style_text_color="0xffffff"
			x="-6"
		/>
		<lv_label
			text="°C"
			align="center"
			x="86"
			y="-64"
			style_text_font="roboto_regular_24"
			style_text_color="0x7a8394"
		/>

		<!-- 10. Below Center: RPM -->
		<lv_label
			bind_text="engine_rpm_str"
			align="top_mid"
			y="246"
			style_text_font="roboto_bold_40"
			style_text_color="0xffffff"
		/>
		<lv_label
			text="Rpm"
			align="top_mid"
			y="282"
			style_text_font="roboto_regular_24"
			style_text_color="0x7a8394"
		/>

		<!-- 11. Bottom Section: Turbo Boost & Intake Temp -->
		<lv_image src="turbo" align="center" x="-68" y="120" />
		<lv_label
			bind_text="turbo_boost_str"
			align="center"
			x="-10"
			y="120"
			style_text_font="roboto_regular_24"
			style_text_color="0xb84a22"
		/>
		<lv_label
			bind_text="intake_temp_str"
			align="center"
			x="54"
			y="120"
			style_text_font="roboto_regular_24"
			style_text_color="0x7a8394"
		/>

		<!-- 12. Left Side: G-Forces -->
		<lv_label
			bind_text="g_force_str"
			align="center"
			x="-123"
			y="-12"
			style_text_font="roboto_regular_24"
			style_text_color="0xffffff"
		/>

		<!-- 13. Right Side: Instant Fuel Consumption Readout -->
		<lv_label
			bind_text="fuel_consumption_val_str"
			align="center"
			x="118"
			y="-10"
			style_text_font="roboto_bold_40"
			style_text_color="0xffffff"
		/>
		<lv_label
			bind_text="fuel_consumption_unit_str"
			align="center"
			x="118"
			y="24"
			style_text_font="roboto_regular_24"
			style_text_color="0x7a8394"
		/>

		<!-- 14. Warning / Disconnect Overlays -->
		<lv_image src="warning" align="top_left" x="55" y="35">
			<bind_flag_if_eq subject="can_error" flag="hidden" ref_value="0" />
		</lv_image>
		<lv_image src="disconnect" align="top_right" x="-55" y="35">
			<bind_flag_if_eq subject="con_error" flag="hidden" ref_value="0" />
		</lv_image>
	</view>
</screen>
